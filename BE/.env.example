# Backend Server Configuration
PORT=8000
HOST=0.0.0.0
ENVIRONMENT=development

# DeepSeek AI API Configuration (primary, fast cloud model)
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash

# LLM provider: auto (deepseek -> ollama fallback) | deepseek | ollama
LLM_PROVIDER=auto
LLM_TIMEOUT_S=45
LLM_MAX_CONCURRENCY=8
LLM_CACHE_TTL_S=3600

# Local Ollama small model (offline fallback, fast on Apple Silicon)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen3:4b

# KaloPilot - live TikTok Shop market signals
# (optional: also read from ~/.kalopilot/token)
KALOPILOT_TOKEN=

# KaloData OpenAPI - TikTok Shop REAL data (revenue/volume/growth)
# Tạo API key ở kalodata.com Open Center -> Account -> API key
KALODATA_API_KEY=69f84be0-3fe8-4773-8504-a32c76674436
KALODATA_REGION=US
KALODATA_PRICE_MIN=0
KALODATA_PRICE_MAX=0

# Marketplace crawlers (auto-crawl layer)
# Priority: tiktok (Kalodata - REAL data), ebay, amazon (no keys needed)
# Etsy: activate the keystring in the Etsy dev portal with the shared secret first
# NOTE: Etsy/Shopee may fail due to anti-bot; Kalodata (TikTok) is most reliable
CRAWL_SOURCES=tiktok,ebay,amazon
CRAWL_WATCHLIST=personalized tumbler,halloween decor,teacher appreciation gift,dog collar,acrylic night light,christmas ornament,mug,keychain
CRAWL_INTERVAL_MIN=60
CRAWL_MAX_ITEMS=30
CRAWL_AUTO_START=false
CRAWL_DEMO_FALLBACK=false

# Anti-detect browser (fingerprint cloning - tránh bị ban account)
# Modes: stealth (local Chromium + stealth, mặc định) | gologin | adspower | cloak
BROWSER_MODE=stealth
BROWSER_FINGERPRINT=macos_chrome   # macos_chrome | windows_chrome | macos_safari | android_chrome
GOLOGIN_TOKEN=                     # GoLogin desktop app local API token
ADSPOWER_API=http://localhost:50325
CLOAKBROWSER_API=http://localhost:43625
BROWSER_PROFILE_ID=                # clone fingerprint từ profile cụ thể trong anti-detect app

# CloakBrowser sidecar - stealth browser chạy trên HOST (IP nhà, qua mọi bot-wall)
# Run trên host:  python scripts/cloak_sidecar.py   (port 8866)
# Docker (Mac):    http://host.docker.internal:8866
CLOAK_SIDECAR_URL=http://host.docker.internal:8866

# Firecrawl (optional self-host) cho site cứng nhất (Etsy Cloudflare, ...)
FIRECRAWL_API_URL=
FIRECRAWL_API_KEY=

# Proxy (residential/ISP cho site chặn IP datacenter: Etsy/AliExpress/Shopee)
CRAWL_PROXY=

# Session cookies từ account đã mua (Etsy/Shopee/TikTok) - inject vào sidecar
# Format: "sessionid=xxx; ua=yyy" hoặc JSON list [{name,value,domain}]
SIDECAR_COOKIES=

# API protection
RATE_LIMIT_PER_MINUTE=120
RATE_LIMIT_BURST=30

# Data
DATA_CSV_NAME=PW_Daily_Keyword_Research - Data.csv
